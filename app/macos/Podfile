platform :osx, '12.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '12.0'
    end
  end
  
  # 配置 llama.cpp 静态库链接
  runner_target = installer.pods_project.targets.find { |t| t.name == 'Runner' }
  if runner_target.nil?
    runner_target = installer.aggregate_targets.find { |t| t.name.include?('Runner') }
  end
  
  # 添加到 Runner target 的配置
  installer.pods_project.native_targets.each do |target|
    if target.name == 'Runner'
      target.build_configurations.each do |config|
        # 添加头文件搜索路径
        config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
        config.build_settings['HEADER_SEARCH_PATHS'] << '$(PROJECT_DIR)/Runner/LlamaCpp/include'
        
        # 添加库搜索路径
        config.build_settings['LIBRARY_SEARCH_PATHS'] ||= ['$(inherited)']
        config.build_settings['LIBRARY_SEARCH_PATHS'] << '$(PROJECT_DIR)/Runner/LlamaCpp'
        
        # 添加 Swift import paths
        config.build_settings['SWIFT_INCLUDE_PATHS'] ||= ['$(inherited)']
        config.build_settings['SWIFT_INCLUDE_PATHS'] << '$(PROJECT_DIR)/Runner/LlamaCpp/include'
        
        # 链接静态库
        config.build_settings['OTHER_LDFLAGS'] ||= ['$(inherited)']
        config.build_settings['OTHER_LDFLAGS'] << '-lllama'
        config.build_settings['OTHER_LDFLAGS'] << '-lggml'
        config.build_settings['OTHER_LDFLAGS'] << '-lggml-base'
        config.build_settings['OTHER_LDFLAGS'] << '-lggml-cpu'
        config.build_settings['OTHER_LDFLAGS'] << '-lggml-metal'
        config.build_settings['OTHER_LDFLAGS'] << '-lggml-blas'
        
        # 添加 Bridging Header
        config.build_settings['SWIFT_OBJC_BRIDGING_HEADER'] = '$(PROJECT_DIR)/Runner/LlamaCpp-Bridging-Header.h'
        
        # 添加系统框架
        config.build_settings['OTHER_LDFLAGS'] << '-framework Accelerate'
        config.build_settings['OTHER_LDFLAGS'] << '-framework Metal'
        config.build_settings['OTHER_LDFLAGS'] << '-framework MetalKit'
        
        # 启用 C++ 支持
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
      end
    end
  end
end
