source 'https://cdn.cocoapods.org/'

# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

# Xcode Cloud/CI 可能无法解析 dldir1.qq.com（微信 OpenSDK 默认下载域名）。
# 这里提供一个可选覆盖：在 CI 中设置环境变量 WECHAT_OPENSDK_ZIP_URL（指向可访问镜像 zip）
# 即可使用本地 podspec 下载，从而绕开 DNS 问题。

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  wechat_podspec = File.join(__dir__, 'WechatOpenSDK-XCFramework.podspec')
  if ENV['CI'] == 'TRUE' && (ENV['WECHAT_OPENSDK_ZIP_URL'].nil? || ENV['WECHAT_OPENSDK_ZIP_URL'].strip.empty?)
    raise "CI 环境检测到 WechatOpenSDK-XCFramework 可能因 dldir1.qq.com DNS 失败。请在 Xcode Cloud Workflow 设置 WECHAT_OPENSDK_ZIP_URL（指向可访问镜像，例如 GitHub Release 上的 OpenSDK2.0.5.zip）。"
  end
  if !ENV['WECHAT_OPENSDK_ZIP_URL'].nil? && !ENV['WECHAT_OPENSDK_ZIP_URL'].strip.empty?
    pod 'WechatOpenSDK-XCFramework', :podspec => wechat_podspec
  end
  # 自动检测本地包，解决国内网络无法下载 dl.google.com 资源的问题
  local_pkg = File.join(__dir__, 'local_pods', 'GoogleMLKit-5.0.0.tar.gz')
  if File.exist?(local_pkg)
    puts "✅ 检测到本地 GoogleMLKit 包: #{local_pkg}，将从本地安装。"
    pod 'GoogleMLKit', :http => "file://#{local_pkg}"
    pod 'GoogleMLKit/DigitalInkRecognition'
  else
    puts "⚠️ 未发现本地 GoogleMLKit 包，尝试从 Google 服务器下载..."
    pod 'GoogleMLKit/DigitalInkRecognition'
  end

  # 用重构后的 XCFramework 覆盖 GoogleMLKit 的单个 fat framework。
  # 背景：Google 把 MLKit*.framework 做成 »arm64(真机)+x86_64(模拟器)« 的单个 fat 二进制，
  # 无法同时容纳 arm64-真机 与 arm64-模拟器 两套片，导致 M 系列模拟器不原生支持。
  # 这里用 build_mlkit_xcframework.sh 生成的 XCFramework(真机片+模拟器片分离)替换，
  # 使得「真机归档」与「Apple Silicon 原生模拟器」都可用，且不再对二进制做破坏性原地修改。
  # 用 :path 指向本地目录(内含 podspec + xcframework)，避免 CocoaPods 从 dl.google.com 下载。
  # 声明在 GoogleMLKit 之后，CocoaPods 会以本地 pod 覆盖其同名传递依赖。
  pod 'MLKitCommon', :path => File.join(__dir__, 'local_mlkit', 'MLKitCommon')
  pod 'MLKitDigitalInkRecognition', :path => File.join(__dir__, 'local_mlkit', 'MLKitDigitalInkRecognition')
  pod 'MLKitMDD', :path => File.join(__dir__, 'local_mlkit', 'MLKitMDD')

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    target.build_configurations.each do |config|
      # 排除 i386，保留 arm64 以原生支持 Apple Silicon 模拟器
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386'
      
      # 自动签名设置
      config.build_settings['DEVELOPMENT_TEAM'] = 'FYU9ZT6D7N'
      config.build_settings['CODE_SIGN_STYLE'] = 'Automatic'
      
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'

      # 配置 permission_handler 权限宏，使得 iOS 真机和模拟器可以正常弹出相应权限申请框
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_MICROPHONE=1',
      ]
    end

    # 为 fluwx 添加微信 SDK 头文件搜索路径
    if target.name == 'fluwx'
      target.build_configurations.each do |config|
        config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
        config.build_settings['HEADER_SEARCH_PATHS'] << '${PODS_ROOT}/WechatOpenSDK-XCFramework/WechatOpenSDK.xcframework/ios-arm64/WechatOpenSDK.framework/Headers'
        config.build_settings['HEADER_SEARCH_PATHS'] << '${PODS_ROOT}/WechatOpenSDK-XCFramework/WechatOpenSDK.xcframework/ios-arm64_x86_64-simulator/WechatOpenSDK.framework/Headers'
      end
    end
  end
end
