source 'https://cdn.cocoapods.org/'

# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

# Xcode Cloud/CI 可能无法解析 dldir1.qq.com（微信 OpenSDK 默认下载域名）。
# 这里提供一个可选覆盖：在 CI 中设置环境变量 WECHAT_OPENSDK_ZIP_URL（指向可访问镜像 zip）
# 即可使用本地 podspec 下载，从而绕开 DNS 问题。

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  wechat_podspec = File.join(__dir__, 'WechatOpenSDK-XCFramework.podspec')
  if ENV['CI'] == 'TRUE' && (ENV['WECHAT_OPENSDK_ZIP_URL'].nil? || ENV['WECHAT_OPENSDK_ZIP_URL'].strip.empty?)
    raise "CI 环境检测到 WechatOpenSDK-XCFramework 可能因 dldir1.qq.com DNS 失败。请在 Xcode Cloud Workflow 设置 WECHAT_OPENSDK_ZIP_URL（指向可访问镜像，例如 GitHub Release 上的 OpenSDK2.0.5.zip）。"
  end
  if !ENV['WECHAT_OPENSDK_ZIP_URL'].nil? && !ENV['WECHAT_OPENSDK_ZIP_URL'].strip.empty?
    pod 'WechatOpenSDK-XCFramework', :podspec => wechat_podspec
  end
  # 自动检测本地包，解决国内网络无法下载 dl.google.com 资源的问题
  local_pkg = File.join(__dir__, 'local_pods', 'GoogleMLKit-5.0.0.tar.gz')
  if File.exist?(local_pkg)
    puts "✅ 检测到本地 GoogleMLKit 包: #{local_pkg}，将从本地安装。"
    pod 'GoogleMLKit', :http => "file://#{local_pkg}"
    pod 'GoogleMLKit/DigitalInkRecognition'
  else
    puts "⚠️ 未发现本地 GoogleMLKit 包，尝试从 Google 服务器下载..."
    pod 'GoogleMLKit/DigitalInkRecognition'
  end

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    # 核心修复：解决 M1/M2 Mac 下 GoogleMLKit 的 arm64 架构冲突问题
    target.build_configurations.each do |config|
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end

    # 为 fluwx 添加微信 SDK 头文件搜索路径
    if target.name == 'fluwx'
      target.build_configurations.each do |config|
        config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
        config.build_settings['HEADER_SEARCH_PATHS'] << '${PODS_ROOT}/WechatOpenSDK-XCFramework/WechatOpenSDK.xcframework/ios-arm64/WechatOpenSDK.framework/Headers'
        config.build_settings['HEADER_SEARCH_PATHS'] << '${PODS_ROOT}/WechatOpenSDK-XCFramework/WechatOpenSDK.xcframework/ios-arm64_x86_64-simulator/WechatOpenSDK.framework/Headers'
      end
    end
  end
end
